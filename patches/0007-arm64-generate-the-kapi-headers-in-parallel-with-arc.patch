From 607e24c774de772539f0d73f9a6a76edb07fd392 Mon Sep 17 00:00:00 2001
From: vroom <vroom@localhost>
Date: Sat, 7 Nov 2026 22:45:47 +0100
Subject: [PATCH] arm64: generate the kapi headers in parallel with archprepare

The cpucap/sysreg/hwcap headers were generated by archprepare's recipe,
which make runs only after all of archprepare's prerequisites (the
asm-generic wrappers, syscall tables, version headers, ...), although
they depend on none of them.  Make it a prerequisite instead.  The
headers are in generated-y, so the asm-generic stale-header removal
leaves them alone.
---
 arch/arm64/Makefile | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/Makefile b/arch/arm64/Makefile
index ed28f94be..26142a116 100644
--- a/arch/arm64/Makefile
+++ b/arch/arm64/Makefile
@@ -190,7 +190,11 @@ install: KBUILD_IMAGE := $(DEFAULT_KBUILD_IMAGE)
 install zinstall:
 	$(call cmd,install)
 
-archprepare:
+# A prerequisite rather than archprepare's recipe, so that the headers are
+# generated in parallel with the other archprepare prerequisites.
+PHONY += arm64_kapi
+archprepare: arm64_kapi
+arm64_kapi:
 	$(Q)$(MAKE) $(build)=arch/arm64/tools kapi
 
 ifeq ($(KBUILD_EXTMOD),)
