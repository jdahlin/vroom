+		buf_printf(buf, "\t.ascii \"%s\"\n", field->value);
+		return strlen(field->value);
+	}
+
+	buf_printf(buf, "\t" MOD_PTR_DIRECTIVE " %s\n", field->value);
+	return MOD_SIZEOF_LONG;
