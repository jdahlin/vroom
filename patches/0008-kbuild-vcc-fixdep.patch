From 285928a0cd44915f8ead034ac4e689a082ed0f87 Mon Sep 17 00:00:00 2001
From: Johan Dahlin <jdahlin@gmail.com>
Date: Sun, 8 Nov 2026 16:25:30 +0100
Subject: [PATCH] kbuild: let vcc do fixdep's work for C and .S objects
 (KBUILD_VCC_FIXDEP=1)

With CC served by vccd, the compiler writes the .cmd file (fixdep's exact
output) and removes the dep file after a successful compile, so an object
costs one shell and one compiler process instead of also fixdep and rm.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 scripts/Kbuild.include | 8 ++++++++
 scripts/Makefile.lib   | 4 ++--
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/scripts/Kbuild.include b/scripts/Kbuild.include
index a38c460ec..f65381b67 100644
--- a/scripts/Kbuild.include
+++ b/scripts/Kbuild.include
@@ -208,6 +208,14 @@ cmd_and_fixdep =                                                             \
 	$(objtree)/scripts/basic/fixdep $(depfile) $@ '$(make-cmd)' > $(dot-target).cmd;\
 	rm -f $(depfile)
 
+# With KBUILD_VCC_FIXDEP=1 (CC is vcc, served by vccd): the compiler does
+# what fixdep and rm do above once the compile has succeeded, so an object
+# costs one shell and one compiler process.  The .cmd file is the same.
+cmd_and_vccdep = @$(if $(cmd_$(1)),set -e; $($(quiet)log_print) $(delete-on-interrupt) \
+	VCC_FIXDEP_D=$(depfile) VCC_FIXDEP_T=$@ VCC_FIXDEP_O=$(dot-target).cmd \
+	VCC_FIXDEP_CMD='$(make-cmd)' $(cmd_$(1)),:)
+cmd_and_ccdep = $(if $(KBUILD_VCC_FIXDEP),$(cmd_and_vccdep),$(cmd_and_fixdep))
+
 # Usage: $(call if_changed_rule,foo)
 # Will check if $(cmd_foo) or any of the prerequisites changed,
 # and if so will execute $(rule_foo).
diff --git a/scripts/Makefile.lib b/scripts/Makefile.lib
index 8936925d4..db0b8c908 100644
--- a/scripts/Makefile.lib
+++ b/scripts/Makefile.lib
@@ -267,7 +267,7 @@ quiet_cmd_cc_o_c = CC $(quiet_modtag)  $@
 		$(cmd_objtool)
 
 define rule_cc_o_c
-	$(call cmd_and_fixdep,cc_o_c)
+	$(call cmd_and_ccdep,cc_o_c)
 	$(call cmd,save_c_flags)
 	$(call cmd,checksrc)
 	$(call cmd,checkdoc)
@@ -281,7 +281,7 @@ quiet_cmd_as_o_S = AS $(quiet_modtag)  $@
       cmd_as_o_S = $(CC) $(a_flags) -c -o $@ $< $(cmd_objtool)
 
 define rule_as_o_S
-	$(call cmd_and_fixdep,as_o_S)
+	$(call cmd_and_ccdep,as_o_S)
 	$(call cmd,gen_objtooldep)
 	$(call cmd,gen_symversions_S)
 	$(call cmd,warn_shared_object)
