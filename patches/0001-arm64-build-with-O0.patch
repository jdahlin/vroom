+/*
+ * Macros instead of __always_inline functions: the "i" operand must be a
+ * constant already in the frontend, so that the kernel can be built with -O0.
+ */
+#define arch_static_branch(key, branch) ({				\
+	__label__ __l_yes, __l_out;					\
+	bool __ret = false;						\
+	asm goto(							\
+		ARCH_STATIC_BRANCH_ASM("%c0", "%l[__l_yes]")		\
+		:  :  "i"(&((char *)(key))[branch]) :  : __l_yes	\
+		);							\
+	goto __l_out;							\
+__l_yes:								\
+	__ret = true;							\
+__l_out:								\
+	__ret;								\
+})
+
+#define arch_static_branch_jump(key, branch) ({			\
+	__label__ __l_yes, __l_out;					\
+	bool __ret = false;						\
+	asm goto(							\
+		"1:	b		%l[__l_yes]		\n\t"		\
+		JUMP_TABLE_ENTRY("%c0", "%l[__l_yes]")			\
+		:  :  "i"(&((char *)(key))[branch]) :  : __l_yes	\
+		);							\
+	goto __l_out;							\
+__l_yes:								\
+	__ret = true;							\
+__l_out:								\
+	__ret;								\
+})
 
 #endif  /* __ASSEMBLER__ */
 #endif	/* __ASM_JUMP_LABEL_H */
