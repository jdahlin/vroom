--- a/scripts/kconfig/parser.y
+++ b/scripts/kconfig/parser.y
@@ -572,6 +572,7 @@ void conf_parse(const char *name)
 	if (getenv("ZCONF_DEBUG"))
 		yydebug = 1;
 	yyparse();
+	preprocess_parse_done();
 
