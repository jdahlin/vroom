# allmodconfig minus what vcc or a macOS host cannot build (KCONFIG_ALLCONFIG):
# sanitizers, CFI, -Werror, module signing and the keyrings (OpenSSL host
# programs), the 32-bit vDSO (no arm32 target).
# CONFIG_WERROR is not set
# CONFIG_KASAN is not set
# CONFIG_UBSAN is not set
# CONFIG_KCSAN is not set
# CONFIG_KMSAN is not set
# CONFIG_KCOV is not set
# CONFIG_GCOV_KERNEL is not set
# CONFIG_CFI is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_SHADOW_CALL_STACK is not set
CONFIG_LTO_NONE=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_RANDSTRUCT_NONE=y
# CONFIG_MODVERSIONS is not set
# CONFIG_SAMPLES is not set
# CONFIG_UAPI_HEADER_TEST is not set
# CONFIG_RUST is not set
# CONFIG_KASAN_HW_TAGS is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set
# CONFIG_SYSTEM_BLACKLIST_KEYRING is not set
# CONFIG_INTEGRITY is not set
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
# CONFIG_IMA is not set
# CONFIG_COMPAT_VDSO is not set
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG is not set
# CONFIG_FS_VERITY_BUILTIN_SIGNATURES is not set
# CONFIG_KEXEC_BZIMAGE_VERIFY_SIG is not set
# CONFIG_SECURITY_IPE is not set
# CONFIG_UBIFS_FS_AUTHENTICATION is not set
# CONFIG_KEXEC_SIG is not set
# CONFIG_KEXEC_IMAGE_VERIFY_SIG is not set
