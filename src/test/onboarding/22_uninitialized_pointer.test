id = "B22"
title = "Pointer declaration creates no pointed-to object"
expect = [
  { line = 3, severity = "warning", pattern = "uninitialized|uninitialised|pointer.*(assign|initializ)" },
]
known_gap = "Observed x86 vcc baseline is silent for dereferencing an uninitialized pointer; distinguish the pointer variable from pointed-to storage."

=== broken.c ===
int main(void) {
    int *p;
    *p = 1;
    return 0;
}
=== fixed.c ===
int main(void) {
    int n = 0;
    int *p = &n;
    *p = 1;
    return 0;
}
=== valid.c ===
int main(void) { int n=0; int *p; p=&n; *p=1; return n != 1; }
