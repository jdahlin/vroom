id = "B06"
title = "Assignment where comparison may be intended"
expect = [
  { line = 3, severity = "warning", pattern = "assignment.*(condition|truth)|assign.*condition|parentheses.*assignment" },
]

=== broken.c ===
int main(void) {
    int n = 0;
    if (n = 3) return 0;
    return 1;
}
=== fixed.c ===
int main(void) {
    int n = 0;
    if (n == 3) return 0;
    return 1;
}
=== valid.c ===
int main(void) { int n = 0; if ((n = 3)) return n != 3; return 1; }
=== stderr ===
broken.c:3:11: warning: using the result of an assignment as a condition without parentheses [-Wparentheses]
    3 |     if (n = 3) return 0;
      |         ~~^~~
broken.c:3:11: note: place parentheses around the assignment to silence this warning
    3 |     if (n = 3) return 0;
      |           ^  
      |         (    )
broken.c:3:11: note: use '==' to turn this assignment into an equality comparison
    3 |     if (n = 3) return 0;
      |           ^
      |           ==
1 warning generated.
