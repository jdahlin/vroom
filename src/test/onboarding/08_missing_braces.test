id = "B08"
title = "Indentation suggests two controlled statements"
flags = ["-Wmisleading-indentation"]
expect = [
  { line = 5, severity = "warning", pattern = "misleading.*indent|indent.*(guard|if)|not guard" },
]
known_gap = "Observed x86 vcc baseline is silent with -Wmisleading-indentation; indentation can suggest intent but must not trigger an automatic brace insertion."

=== broken.c ===
int main(void) {
    int n = 0;
    if (n == 1)
        n = 2;
        n = 3;
    return n != 3;
}
=== fixed.c ===
int main(void) {
    int n = 0;
    if (n == 1) {
        n = 2;
        n = 3;
    }
    return n != 3;
}
=== valid.c ===
int main(void) { int n = 0; if (n == 1) n = 2;
    n = 3; return n != 3; }
