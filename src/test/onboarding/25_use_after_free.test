id = "B25"
title = "Read through a pointer after freeing its object"
expect = [
  { line = 8, severity = "warning", pattern = "use.after.free|used after.*free|freed.*(memory|object|pointer)|deallocated" },
]
known_gap = "Ordinary frontends may miss even simple post-free uses; explicit analyzer or data-flow support may be required."

=== broken.c ===
typedef __SIZE_TYPE__ size_t;
void *malloc(size_t); void free(void *);
int main(void) {
    int *p = malloc(sizeof *p);
    if (!p) return 1;
    *p = 7;
    free(p);
    return *p;
}
=== fixed.c ===
typedef __SIZE_TYPE__ size_t;
void *malloc(size_t); void free(void *);
int main(void) {
    int *p = malloc(sizeof *p);
    if (!p) return 1;
    *p = 7;
    int result = *p;
    free(p);
    return result;
}
=== valid.c ===
typedef __SIZE_TYPE__ size_t;
void *malloc(size_t); void free(void *);
int main(void) { int *p=malloc(sizeof *p); if(!p)return 1; free(p); p=0; return p != 0; }
