; a value that is in its slot in front of a loop (it crossed calls with the
; callee-saved registers taken) and is used in the loop is loaded on the edge
; into the loop, once, not in the body on every round
; REGS: 6,4,2,1
; SWEEP: yes
vir 1
target x86_64-linux
extern @g
sig %s = (int, int, int, int) -> int
sig %g = (int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = param 1.0
  v2:i64 = param 2.0
  v3:i64 = param 3.0
  v4:i64 = call @g %g (v0)
  v5:i64 = call @g %g (v1)
  v6:i64 = call @g %g (v2)
  v7:i64 = call @g %g (v3)
  br b1(0:i64, 0:i64)
b1(v8:i64, v9:i64):
  v10:i32 = icmp.slt v8, v0
  brif v10, b2, b3
b2:
  v11:i64 = and v9, v4
  v12:i64 = add v11, v5
  v13:i64 = xor v12, v6
  v14:i64 = add v8, 1:i64
  br b1(v14, v13)
b3:
  v15:i64 = add v9, v7
  v16:i64 = add v15, v1
  ret v16
}
; ---
; alloc @f regs 6,4,2,1
func @f %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0
  ; move r4 <- r0 (v0)
  v1:i64 = param 1.0                    ; -> r1 [ss5 later]
  ; move r5 <- r1 (v1)
  v2:i64 = param 2.0                    ; -> r2 [ss1 later]
  v3:i64 = param 3.0                    ; -> r0 [ss0 later]
  ; store ss0 <- r0 (v3)
  ; move r0 <- r4 (v0)
  ; store ss1 <- r2 (v2)
  v4:i64 = call @g %s1 (v0)             ; -, r0 -> r0 [ss2 later]
  ; store ss2 <- r0 (v4)
  ; move r0 <- r5 (v1)
  v5:i64 = call @g %s1 (v1)             ; -, r0 -> r0 [ss3 later]
  ; store ss3 <- r0 (v5)
  ; reload r0 <- v2 (ss1)
  v6:i64 = call @g %s1 (v2)             ; -, r0 -> r0 [ss4 later]
  ; store ss4 <- r0 (v6)
  ; reload r0 <- v3 (ss0)
  v7:i64 = call @g %s1 (v3)             ; -, r0 -> r0 [ss1 later]
  br b1(0, 0)                           ; -, -
b1(v8:i64, v9:i64):                     ; loop to b2 depth 1; v8 r0, v9 r1
  v10:i32 = icmp.slt v8, v0             ; r0, r4 -> r3
  brif v10, b2, b3                      ; r3
b2:
  v11:i64 = and v9, v4                  ; r1, r5 -> r1
  v12:i64 = add v11, v5                 ; r1, r2 -> r1
  ; reload r3 <- v6 (ss4)
  v13:i64 = xor v12, v6                 ; r1, r3 -> r1
  v14:i64 = add v8, 1                   ; r0, - -> r0
  br b1(v14, v13)                       ; r0, r1
b3:
  ; reload r0 <- v7 (ss1)
  v15:i64 = add v9, v7                  ; r1, r0 -> r0
  ; reload r1 <- v1 (ss5)
  v16:i64 = add v15, v1                 ; r0, r1 -> r0
  ret v16                               ; r0
}
; edge b0.0 -> b1: ss1 <- r0 (v7); ss5 <- r5 (v1); r2 <- ss3 (v5); r1 <- 0; r0 <- 0; r5 <- ss2 (v4)
; spill slots: ss0(8): v3 ss1(8): v2 v7 ss2(8): v4 ss3(8): v5 ss4(8): v6 ss5(8): v1
; callee-saved: r4 (b0) r5 (b0)
; spills 7 reloads 5 remats 0 moves 4 swaps 0 stores 5; edges 1: moves 0 reloads 2 remats 2 stores 2 xchg 0; slots 6 callee 2
; sweep @f: 144 configurations, 0 failed
