; a call's arguments that move from one argument register to the next are a
; parallel move: each is copied before its register is written, none is
; moved aside first
; REGS: 6,4,2,1
; SWEEP: yes
vir 1
target x86_64-linux
extern @g
sig %s = (int, int, int) -> int
sig %g = (int, int, int, int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = param 1.0
  v2:i64 = param 2.0
  v3:i64 = call @g %g (7:i64, v0, v1, v2)
  ret v3
}
; ---
; alloc @f regs 6,4,2,1
func @f %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0
  v1:i64 = param 1.0                    ; -> r1
  v2:i64 = param 2.0                    ; -> r2
  ; move r3 <- r2 (v2)
  ; move r2 <- r1 (v1)
  ; move r1 <- r0 (v0)
  ; remat r0 <- 7
  v3:i64 = call @g %s1 (7:i64, v0, v1, v2) ; -, r0, r1, r2, r3 -> r0
  ret v3                                ; r0
}
