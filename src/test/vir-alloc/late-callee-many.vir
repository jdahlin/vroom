; A late-used loop parameter crosses a call, on a target with many callee-saved
; registers (arm64 has ten): it keeps its callee-saved register only while at
; least two other callee-saved registers stay free, so with the other registers
; taken by values live through the loop it enters in its slot.  The few-register
; rule (late-callee.vir) would keep the register.
; REGS: 12,2,10,0
; SWEEP: yes
vir 1
target x86_64-linux
extern @g
sig %s = (int, int, int, int, int, int, int, int, int, int) -> int
sig %g = (int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = param 1.0
  v2:i64 = param 2.0
  v3:i64 = param 3.0
  v4:i64 = param 4.0
  v5:i64 = param 5.0
  v6:i64 = param 6.0
  v7:i64 = param 7.0
  v8:i64 = param 8.0
  v9:i64 = param 9.0
  br b1(v0, v1)
b1(v10:i64, v11:i64):
  v12:i32 = icmp.sgt v10, 0:i64
  brif v12, b2, b3
b2:
  v13:i64 = call @g %g (1:i64)
  v14:i64 = add v11, v13
  v15:i64 = sub v10, 1:i64
  br b1(v15, v14)
b3:
  v16:i64 = add v11, v2
  v17:i64 = add v16, v3
  v18:i64 = add v17, v4
  v19:i64 = add v18, v5
  v20:i64 = add v19, v6
  v21:i64 = add v20, v7
  v22:i64 = add v21, v8
  v23:i64 = add v22, v9
  ret v23
}
; ---
; alloc @f regs 12,2,10,0
func @f %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0
  ; move r2 <- r0 (v0)
  v1:i64 = param 1.0                    ; -> r3
  v2:i64 = param 2.0                    ; -> r4
  v3:i64 = param 3.0                    ; -> r5
  v4:i64 = param 4.0                    ; -> r6
  v5:i64 = param 5.0                    ; -> r7
  v6:i64 = param 6.0                    ; -> r8
  v7:i64 = param 7.0                    ; -> r9
  v8:i64 = param 8.0                    ; -> r10
  v9:i64 = param 9.0                    ; -> r11
  br b1(v0, v1)                         ; r2, r3
b1(v10:i64, v11:i64):                   ; loop to b2 depth 1; v10 r2, v11 ss0
  v12:i32 = icmp.sgt v10, 0             ; r2, - -> r0
  brif v12, b2, b3                      ; r0
b2:
  ; remat r0 <- 1
  v13:i64 = call @g %s1 (1:i64)         ; -, r0 -> r0
  ; reload r3 <- v11 (ss0)
  v14:i64 = add v11, v13                ; r3, r0 -> r3
  v15:i64 = sub v10, 1                  ; r2, - -> r2
  br b1(v15, v14)                       ; r2, r3
b3:
  ; reload r3 <- v11 (ss0)
  v16:i64 = add v11, v2                 ; r3, r4 -> r0
  v17:i64 = add v16, v3                 ; r0, r5 -> r0
  v18:i64 = add v17, v4                 ; r0, r6 -> r0
  v19:i64 = add v18, v5                 ; r0, r7 -> r0
  v20:i64 = add v19, v6                 ; r0, r8 -> r0
  v21:i64 = add v20, v7                 ; r0, r9 -> r0
  v22:i64 = add v21, v8                 ; r0, r10 -> r0
  v23:i64 = add v22, v9                 ; r0, r11 -> r0
  ret v23                               ; r0
}
; edge b0.0 -> b1: ss0 <- r3 (v1)
; edge b2.0 -> b1: ss0 <- r3 (v14)
; spill slots: ss0(8): v11
; callee-saved: r2 (b0) r3 (b0) r4 (b0) r5 (b0) r6 (b0) r7 (b0) r8 (b0) r9 (b0) r10 (b0) r11 (b0)
; spills 1 reloads 2 remats 1 moves 1 swaps 0 stores 0; edges 2: moves 0 reloads 0 remats 0 stores 2 xchg 0; slots 1 callee 10
; sweep @f: 120 configurations, 0 failed
