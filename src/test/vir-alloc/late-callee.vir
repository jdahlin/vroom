; A late-used loop parameter crosses a call, on a target with few callee-saved
; registers (x86-64 has five): the other parameter occupies one callee-saved
; register; the last free one keeps this value across the call without two
; additional spare callee-saved registers (late-callee-many.vir: the rule of a
; target with many).
; REGS: 4,2,2,0
; SWEEP: yes
vir 1
target x86_64-linux
extern @g
sig %s = (int, int) -> int
sig %g = (int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = param 1.0
  br b1(v0, v1)
b1(v2:i64, v3:i64):
  v4:i32 = icmp.sgt v2, 0:i64
  brif v4, b2, b3
b2:
  v5:i64 = call @g %g (1:i64)
  v6:i64 = add v3, v5
  v7:i64 = sub v2, 1:i64
  br b1(v7, v6)
b3:
  ret v3
}
; ---
; alloc @f regs 4,2,2,0
func @f %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0
  ; move r2 <- r0 (v0)
  v1:i64 = param 1.0                    ; -> r3
  br b1(v0, v1)                         ; r2, r3
b1(v2:i64, v3:i64):                     ; loop to b2 depth 1; v2 r2, v3 r3
  v4:i32 = icmp.sgt v2, 0               ; r2, - -> r0
  brif v4, b2, b3                       ; r0
b2:
  ; remat r0 <- 1
  v5:i64 = call @g %s1 (1:i64)          ; -, r0 -> r0
  v6:i64 = add v3, v5                   ; r3, r0 -> r3
  v7:i64 = sub v2, 1                    ; r2, - -> r2
  br b1(v7, v6)                         ; r2, r3
b3:
  ; move r0 <- r3 (v3)
  ret v3                                ; r0
}
; callee-saved: r2 (b0) r3 (b0)
; spills 0 reloads 0 remats 1 moves 2 swaps 0 stores 0; edges 0: moves 0 reloads 0 remats 0 stores 0 xchg 0; slots 0 callee 2
; sweep @f: 24 configurations, 0 failed
