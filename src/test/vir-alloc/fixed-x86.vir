; x86 constraints: shift counts in r2, division in r0/r1, two-address
; operations; values sitting in the fixed registers must move out
; REGS: 5,2,0,0
; X86: yes
; SWEEP: yes
vir 1
target x86_64-linux
sig %s = (int, int, int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = param 1.0
  v2:i64 = param 2.0
  v3:i64 = shl v0, v1
  v4:i64 = sdiv v3, v2
  v5:i64 = srem v3, v2
  v6:i64 = lshr v4, v2
  v7:i64 = sub v5, v6
  v8:i64 = add v0, v7
  v9:i64 = udiv v8, v8
  v10:i64 = add v9, v1
  v11:i64 = mul v2, v10
  v12:i64 = sub v11, v0
  ret v12
}
; ---
; alloc @f regs 5,2,0,0 x86
func @f %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0
  v1:i64 = param 1.0                    ; -> r1 [ss0 later]
  v2:i64 = param 2.0                    ; -> r2
  ; move r3 <- r2 (v2)
  ; move r2 <- r1 (v1)
  v3:i64 = shl v0, v1                   ; r0, r2 -> r4
  ; move r2 <- r0 (v0)
  ; move r0 <- r4 (v3)
  ; store ss0 <- r1 (v1)
  v4:i64 = sdiv v3, v2                  ; r0, r3 -> r0 [ss1 later]
  ; store ss1 <- r0 (v4)
  ; move r0 <- r4 (v3)
  v5:i64 = srem v3, v2                  ; r0, r3 -> r1
  ; move r0 <- r2 (v0)
  ; move r2 <- r3 (v2)
  ; reload r4 <- v4 (ss1)
  v6:i64 = lshr v4, v2                  ; r4, r2 -> r4
  v7:i64 = sub v5, v6                   ; r1, r4 -> r1
  ; swap operands
  v8:i64 = add v0, v7                   ; r0, r1 -> r1
  ; move r2 <- r0 (v0)
  ; move r0 <- r1 (v8)
  ; move r4 <- r1 (v8)
  v9:i64 = udiv v8, v8                  ; r0, r4 -> r0
  ; reload r1 <- v1 (ss0)
  v10:i64 = add v9, v1                  ; r0, r1 -> r0
  v11:i64 = mul v2, v10                 ; r3, r0 -> r3
  v12:i64 = sub v11, v0                 ; r3, r2 -> r3
  ; move r0 <- r3 (v12)
  ret v12                               ; r0
}
; spill slots: ss0(8): v1 ss1(8): v4
; spills 2 reloads 2 remats 0 moves 11 swaps 1 stores 2; edges 0: moves 0 reloads 0 remats 0 stores 0 xchg 0; slots 2 callee 0
; sweep @f: 36 configurations, 0 failed
