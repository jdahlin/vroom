; DOM: yes
; the irreducible graph of Cooper, Harvey and Kennedy (figure 2), entry 6 = b0, 5 = b1, 4 = b2, 1 = b3, 2 = b4, 3 = b5
vir 1
target x86_64-linux
sig %s = (int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  brif v0, b1, b2
b1:
  br b3
b2:
  brif v0, b4, b5
b3:
  br b4
b4:
  brif v0, b3, b5
b5:
  br b4
}
; ---
vir 1
target x86_64-linux
sig %s0 = (int) -> int

func @f %s0 {
b0:
  v0:i64 = param 0.0
  brif v0, b1, b2
b1:
  br b3
b2:
  brif v0, b4, b5
b3:
  br b4
b4:
  brif v0, b3, b5
b5:
  br b4
}
; dom @f b0 idom b0 pre 0 post 5
; dom @f b1 idom b0 pre 1 post 1
; dom @f b2 idom b0 pre 2 post 2
; dom @f b3 idom b0 pre 5 post 5
; dom @f b4 idom b0 pre 4 post 4
; dom @f b5 idom b0 pre 3 post 3
