; DOM: yes
; an irreducible loop (b1 and b2 each reach the other, both are entered from b0): both are dominated by b0
vir 1
target x86_64-linux
sig %s = (int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  brif v0, b1, b2
b1:
  brif v0, b2, b3
b2:
  brif v0, b1, b3
b3:
  ret v0
}
; ---
vir 1
target x86_64-linux
sig %s0 = (int) -> int

func @f %s0 {
b0:
  v0:i64 = param 0.0
  brif v0, b1, b2
b1:
  brif v0, b2, b3
b2:
  brif v0, b1, b3
b3:
  ret v0
}
; dom @f b0 idom b0 pre 0 post 3
; dom @f b1 idom b0 pre 2 post 2
; dom @f b2 idom b0 pre 1 post 1
; dom @f b3 idom b0 pre 3 post 3
