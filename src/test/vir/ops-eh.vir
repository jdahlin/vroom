; their clauses, the selector compared with ehtypeid, resume, a noreturn invoke (__cxa_throw)
vir 1
target arm64-linux
extern @may_throw
extern @__cxa_throw
extern @__cxa_begin_catch
extern @__cxa_end_catch
extern @_ZTIi
extern @_ZTIc
extern @__gxx_personality_v0
sig %s = (int) -> int
sig %p = (int) -> int
sig %t = (int, int, int) -> none
sig %v = () -> none

func @cleanup %s personality @__gxx_personality_v0 {
b0:
  v0:i64 = param 0.0
  v1:i64 = invoke @may_throw %s (v0) -> b1 unwind b2
b1:
  v2:i64 = add v1, v0
  ret v2
b2 lpad:
  v3:multi = landingpad cleanup
  v4:ptr = proj v3, 0
  call @__cxa_end_catch %v ()
  resume v4
}

func @catches %s personality @__gxx_personality_v0 {
b0:
  v0:i64 = param 0.0
  v1:i64 = invoke @may_throw %s (v0) -> b1 unwind b2
b1:
  ret v1
b2 lpad:
  v3:multi = landingpad catch @_ZTIi catch @_ZTIc catchall
  v4:ptr = proj v3, 0
  v5:i32 = proj v3, 1
  v6:i32 = ehtypeid @_ZTIi
  v7:i32 = icmp.eq v5, v6
  brif v7, b3, b4
b3:
  v8:ptr = call @__cxa_begin_catch %p (v4)
  call @__cxa_end_catch %v ()
  ret 1:i64
b4:
  resume v4
}

func @throws %v personality @__gxx_personality_v0 {
b0:
  invoke @__cxa_throw %t (0:ptr, @_ZTIi, 0:ptr) -> b1 unwind b2 noreturn
b1:
  trap
b2 lpad:
  v0:multi = landingpad cleanup
  v1:ptr = proj v0, 0
  resume v1
}
