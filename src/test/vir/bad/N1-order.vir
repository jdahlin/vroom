; constants not in order of first use
vir 1
target x86_64-linux
sig %s = (int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = iconst 7
  v2:i64 = iconst 3
  v3:i64 = add v0, v2
  v4:i64 = add v3, v1
  ret v4
}
; ---
@f b0.1: N1: constant 2 is used before constant 1: not in order of first use
