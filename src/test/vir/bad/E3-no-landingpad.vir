; a landing pad that does not start with landingpad
vir 1
target arm64-linux
extern @g
extern @_ZTIi
extern @__gxx_personality_v0
sig %s = (int) -> int
func @f %s personality @__gxx_personality_v0 {
b0:
  v0:i64 = param 0.0
  v1:i64 = invoke @g %s (v0) -> b1 unwind b2
b1:
  ret v1
b2 lpad:
  v2:i64 = add v0, v0
  ret v2
}
; ---
@f b2.0: E3: a landing pad starts with add, not landingpad
