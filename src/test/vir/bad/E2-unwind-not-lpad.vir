; an invoke that unwinds to a block that is not a landing pad
vir 1
target arm64-linux
extern @g
extern @_ZTIi
extern @__gxx_personality_v0
sig %s = (int) -> int
func @f %s personality @__gxx_personality_v0 {
b0:
  v0:i64 = param 0.0
  v1:i64 = invoke @g %s (v0) -> b1 unwind b2
b1:
  ret v1
b2:
  ret v0
}
; ---
@f b0.1: E2: invoke unwinds to b2, which is not a landing pad
