; a slot the function says is not exposed whose address is stored
vir 1
target x86_64-linux
sig %s = (int) -> int
func @f %s exposure {
  slot $0 size 8 align 8
b0:
  v0:i64 = param 0.0
  v1:ptr = i2p v0
  store.8 v1, $0:ptr
  ret v0
}
; ---
@f: M1: slot $0 is exposed, the function says not exposed
