; PASSES: canon,redundant-extensions
; CHANGES: yes
; and 255 of a halfword load keeps its mask
vir 1
target arm64-linux
extern @g
sig %s = (int, int) -> int
sig %gs = (int) -> int
func @f %s {
b0:
  v0:ptr = param 0.0
  v1:i32 = load.2u v0
  v2:i32 = and v1, 255
  v3:i64 = ext.4u v2
  ret v3
}
; ---
vir 1
target arm64-linux
extern @g
sig %s0 = (int, int) -> int
sig %s1 = (int) -> int

func @f %s0 {
b0:
  v0:ptr = param 0.0
  v1:i32 = load.2u v0
  v2:i32 = and v1, 255
  v3:i64 = ext.4u v2
  ret v3
}
; pass redundant-extensions @f: unchanged
