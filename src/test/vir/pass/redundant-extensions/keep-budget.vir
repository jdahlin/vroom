; PASSES: canon,redundant-extensions
; CHANGES: yes
; six parameters pass the byte one place per round: the fixed point needs six rounds, the budget is four, so late parameters fall to unknown and the ext stays
vir 1
target arm64-linux
extern @g
sig %s = (int, int) -> int
sig %gs = (int) -> int
func @f %s {
b0:
  v0:ptr = param 0.0
  v12:i64 = param 1.0
  v1:i32 = trunc v12
  br b1(0, 0, 0, 0, 0, 0)
b1(v2:i32, v3:i32, v4:i32, v5:i32, v6:i32, v7:i32) loop:
  v8:i32 = ext.1u v2
  v9:i32 = load.1u v0
  v10:i32 = icmp.ult v8, v1
  brif v10, b2, b3
b2:
  br b1(v3, v4, v5, v6, v7, v9)
b3:
  v11:i64 = ext.4u v8
  ret v11
}
; ---
vir 1
target arm64-linux
extern @g
sig %s0 = (int, int) -> int
sig %s1 = (int) -> int

func @f %s0 {
b0:
  v0:ptr = param 0.0
  v1:i64 = param 1.0
  v2:i32 = trunc v1
  br b1(0, 0, 0, 0, 0, 0)
b1(v3:i32, v4:i32, v5:i32, v6:i32, v7:i32, v8:i32) loop:
  v9:i32 = ext.1u v3
  v10:i32 = load.1u v0
  v11:i32 = icmp.ult v9, v2
  brif v11, b2, b3
b2:
  br b1(v4, v5, v6, v7, v8, v10)
b3:
  v12:i64 = ext.4u v9
  ret v12
}
; pass redundant-extensions @f: unchanged
