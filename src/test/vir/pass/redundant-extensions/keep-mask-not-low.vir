; PASSES: canon,redundant-extensions
; CHANGES: yes
; and with 254 is not a low mask, and a non-constant and is not a candidate
vir 1
target arm64-linux
extern @g
sig %s = (int, int) -> int
sig %gs = (int) -> int
func @f %s {
b0:
  v0:ptr = param 0.0
  v1:i32 = load.1u v0
  v2:i32 = and v1, 254
  v3:i32 = and v1, v2
  v4:i64 = ext.4u v3
  ret v4
}
; ---
