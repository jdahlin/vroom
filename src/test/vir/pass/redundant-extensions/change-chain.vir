; PASSES: canon,redundant-extensions
; CHANGES: yes
; and of and of a byte load: both ands go in one run
vir 1
target arm64-linux
extern @g
sig %s = (int, int) -> int
sig %gs = (int) -> int
func @f %s {
b0:
  v0:ptr = param 0.0
  v1:i32 = load.1u v0
  v2:i32 = and v1, 255
  v3:i32 = and v2, 255
  v4:i64 = ext.4u v3
  ret v4
}
; ---
vir 1
target arm64-linux
extern @g
sig %s0 = (int, int) -> int
sig %s1 = (int) -> int

func @f %s0 {
b0:
  v0:ptr = param 0.0
  v1:i32 = load.1u v0
  v2:i64 = ext.4u v1
  ret v2
}
; pass redundant-extensions @f: changed, 2 instructions
