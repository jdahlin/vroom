; PASSES: canon,redundant-extensions
; CHANGES: yes
; ext.4u from i32 to i64 changes the type: that case belongs to the lowering
vir 1
target arm64-linux
extern @g
sig %s = (int, int) -> int
sig %gs = (int) -> int
func @f %s {
b0:
  v0:ptr = param 0.0
  v1:i32 = load.1u v0
  v2:i64 = ext.4u v1
  ret v2
}
; ---
vir 1
target arm64-linux
extern @g
sig %s0 = (int, int) -> int
sig %s1 = (int) -> int

func @f %s0 {
b0:
  v0:ptr = param 0.0
  v1:i32 = load.1u v0
  v2:i64 = ext.4u v1
  ret v2
}
; pass redundant-extensions @f: unchanged
