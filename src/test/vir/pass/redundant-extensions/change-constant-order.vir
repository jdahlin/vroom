; PASSES: canon,redundant-extensions
; CHANGES: yes
; the removed and was the first user of 255: the constants are numbered by first use again (7, 9, 255; the verifier's N1)
vir 1
target arm64-linux
sig %s = (int, int) -> int
func @f %s {
b0:
  v0:ptr = param 0.0
  v1:i32 = load.1u v0
  v2:i32 = add v1, 7
  v3:i32 = and v1, 255
  v4:i32 = add v3, 9
  v5:i32 = add v4, 255
  v6:i32 = add v5, v2
  v7:i64 = ext.4u v6
  ret v7
}
