; PASSES: canon,redundant-extensions
; CHANGES: yes
; and 0xffffffff of an i64 loaded as 4 unsigned bytes (z = 32) is the load
vir 1
target arm64-linux
extern @g
sig %s = (int, int) -> int
sig %gs = (int) -> int
func @f %s {
b0:
  v0:ptr = param 0.0
  v1:i64 = load.4u v0
  v2:i64 = and v1, 4294967295
  ret v2
}
