; PASSES: canon,redundant-extensions
; CHANGES: yes
; a signed halfword extension of a signed byte extension is the byte one (s = 8 <= 16)
vir 1
target arm64-linux
extern @g
sig %s = (int, int) -> int
sig %gs = (int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = ext.1s v0
  v2:i64 = ext.2s v1
  ret v2
}
; ---
vir 1
target arm64-linux
extern @g
sig %s0 = (int, int) -> int
sig %s1 = (int) -> int

func @f %s0 {
b0:
  v0:i64 = param 0.0
  v1:i64 = ext.1s v0
  ret v1
}
; pass redundant-extensions @f: changed, 1 instructions
