; PASSES: canon,redundant-extensions
; CHANGES: yes
; x = y >> 25 (logical, i32) is below 2^7: the signed byte ext is gone
vir 1
target arm64-linux
extern @g
sig %s = (int, int) -> int
sig %gs = (int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i32 = trunc v0
  v2:i32 = lshr v1, 25
  v3:i32 = ext.1s v2
  v4:i64 = ext.4s v3
  ret v4
}
; ---
vir 1
target arm64-linux
extern @g
sig %s0 = (int, int) -> int
sig %s1 = (int) -> int

func @f %s0 {
b0:
  v0:i64 = param 0.0
  v1:i32 = trunc v0
  v2:i32 = lshr v1, 25
  v3:i64 = ext.4s v2
  ret v3
}
; pass redundant-extensions @f: changed, 1 instructions
