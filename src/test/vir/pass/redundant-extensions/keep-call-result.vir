; PASSES: canon,redundant-extensions
; CHANGES: yes
; ext.1u of a call result
vir 1
target arm64-linux
extern @g
sig %s = (int, int) -> int
sig %gs = (int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = call @g %gs (v0)
  v2:i64 = ext.1u v1
  ret v2
}
; ---
vir 1
target arm64-linux
extern @g
sig %s0 = (int, int) -> int
sig %s1 = (int) -> int

func @f %s0 {
b0:
  v0:i64 = param 0.0
  v1:i64 = call @g %s1 (v0)
  v2:i64 = ext.1u v1
  ret v2
}
; pass redundant-extensions @f: unchanged
