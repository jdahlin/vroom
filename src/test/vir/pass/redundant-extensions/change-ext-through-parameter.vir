extern @g
sig %s0 = (int, int) -> int
sig %s1 = (int) -> int

func @f %s0 {
b0:
  v0:ptr = param 0.0
  v1:i64 = param 1.0
  brif v1, b1, b2
b1:
  v2:i32 = load.1u v0
  br b3(v2)
b2:
  v3:i32 = load.1u v0
  br b3(v3)
b3(v4:i32):
  v5:i64 = ext.4u v4
  ret v5
}
