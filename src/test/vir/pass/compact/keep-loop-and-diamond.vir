; PASSES: canon,compact
; CHANGES: yes
; DOM: yes
; two functions with block parameters, a loop and a diamond: compact keeps what the passes of the registry keep
; (virtest checks the CFG and dominators after the pass against a fresh computation)
vir 1
target arm64-linux
sig %s = (int) -> int
func @loop %s {
b0:
  v0:i64 = param 0.0
  br b2(0)
b1:
  v3:i64 = add v1, 1
  br b2(v3)
b2(v1:i64) loop:
  v2:i32 = icmp.slt v1, v0
  brif v2, b1, b3
b3:
  ret v1
}
func @diamond %s {
b0:
  v0:i64 = param 0.0
  brif v0, b1, b2
b1:
  v1:i64 = add v0, 7
  br b3(v1)
b2:
  v2:i64 = sub v0, 9
  br b3(v2)
b3(v3:i64):
  ret v3
}
; ---
vir 1
target arm64-linux
sig %s0 = (int) -> int

func @loop %s0 {
b0:
  v0:i64 = param 0.0
  br b1(0)
b1(v1:i64) loop:
  v2:i32 = icmp.slt v1, v0
  brif v2, b2, b3
b2:
  v3:i64 = add v1, 1
  br b1(v3)
b3:
  ret v1
}

func @diamond %s0 {
b0:
  v0:i64 = param 0.0
  brif v0, b1, b2
b1:
  v1:i64 = add v0, 7
  br b3(v1)
b2:
  v2:i64 = sub v0, 9
  br b3(v2)
b3(v3:i64):
  ret v3
}
; pass compact @loop: unchanged
; pass compact @diamond: unchanged
; dom @loop b0 idom b0 pre 0 post 3
; dom @loop b1 idom b0 pre 1 post 3
; dom @loop b2 idom b1 pre 2 post 2
; dom @loop b3 idom b1 pre 3 post 3
; dom @diamond b0 idom b0 pre 0 post 3
; dom @diamond b1 idom b0 pre 1 post 1
; dom @diamond b2 idom b0 pre 2 post 2
; dom @diamond b3 idom b0 pre 3 post 3
