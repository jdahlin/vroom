; floating-point instructions and constants
vir 1
target arm64-linux
sig %s = (f64, f32) -> f64
func @floats %s {
b0:
  v0:f64 = param 0.0
  v1:f32 = param 1.0
  v2:f64 = fadd v0, 0x1.8p+1
  v3:f64 = fsub v0, -0x1p-2
  v4:f64 = fmul v2, bits:0x7ff8000000000000
  v5:f64 = fdiv v3, 0x0p+0
  v6:f32 = fadd v1, 0x1.4p+3
  v7:f32 = fsub v1, bits:0x7fc00000
  v8:f32 = fmul v6, -0x0p+0
  v9:f32 = fdiv v7, bits:0x1
  v10:f64 = fneg v0
  v11:f64 = fabs v10
  v12:f32 = fneg v1
  v13:f32 = fabs v12
  v14:f64 = fsqrt v2
  v15:f32 = fsqrt v6
  v16:f64 = fext v1
  v17:f32 = ftrunc v0
  v18:i64 = f2s v0
  v19:i32 = f2s v1
  v20:i64 = f2u v0
  v21:i32 = f2u v1
  v22:f64 = s2f v18
  v23:f32 = s2f v19
  v24:f64 = u2f v20
  v25:f32 = u2f v21
  v26:i64 = bitcast v0
  v27:i32 = bitcast v1
  v28:f64 = bitcast v26
  v29:f32 = bitcast v27
  v30:i32 = fcmp.oeq v0, v2
  v31:i32 = fcmp.une v0, v2
  v32:i32 = fcmp.olt v0, 0x1p+0
  v33:i32 = fcmp.ole v1, v6
  v34:i32 = fcmp.ogt v0, v2
  v35:i32 = fcmp.oge v0, v2
  v36:i32 = fcmp.uno v0, v2
  v37:i32 = fcmp.one v0, v2
  v38:i32 = fcmp.oeq 0x1p+0:f64, 0x1p+1:f64
  v39:f64 = select v30, v0, 0x1p+10
  v40:f32 = select v31, 0x1p-1, v1
  ret v39
}
; ---
vir 1
target arm64-linux
sig %s0 = (f64, f32) -> f64

func @floats %s0 {
b0:
  v0:f64 = param 0.0
  v1:f32 = param 1.0
  v2:f64 = fadd v0, 0x1.8p+1
  v3:f64 = fsub v0, -0x1p-2
  v4:f64 = fmul v2, bits:0x7ff8000000000000
  v5:f64 = fdiv v3, 0x0p+0
  v6:f32 = fadd v1, 0x1.4p+3
  v7:f32 = fsub v1, bits:0x7fc00000
  v8:f32 = fmul v6, -0x0p+0
  v9:f32 = fdiv v7, bits:0x1
  v10:f64 = fneg v0
  v11:f64 = fabs v10
  v12:f32 = fneg v1
  v13:f32 = fabs v12
  v14:f64 = fsqrt v2
  v15:f32 = fsqrt v6
  v16:f64 = fext v1
  v17:f32 = ftrunc v0
  v18:i64 = f2s v0
  v19:i32 = f2s v1
  v20:i64 = f2u v0
  v21:i32 = f2u v1
  v22:f64 = s2f v18
  v23:f32 = s2f v19
  v24:f64 = u2f v20
  v25:f32 = u2f v21
  v26:i64 = bitcast v0
  v27:i32 = bitcast v1
  v28:f64 = bitcast v26
  v29:f32 = bitcast v27
  v30:i32 = fcmp.oeq v0, v2
  v31:i32 = fcmp.une v0, v2
  v32:i32 = fcmp.olt v0, 0x1p+0
  v33:i32 = fcmp.ole v1, v6
  v34:i32 = fcmp.ogt v0, v2
  v35:i32 = fcmp.oge v0, v2
  v36:i32 = fcmp.uno v0, v2
  v37:i32 = fcmp.one v0, v2
  v38:i32 = fcmp.oeq 0x1p+0:f64, 0x1p+1:f64
  v39:f64 = select v30, v0, 0x1p+10
  v40:f32 = select v31, 0x1p-1, v1
  ret v39
}
