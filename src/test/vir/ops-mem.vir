; pointers, memory, atomics, address constants
vir 1
target arm64-darwin
extern @ext
data @tab align 8 = { i32 1, i64 -2, f32 0x1p+0, f64 -0x1.8p+1, ptr @tab+8, ptr 16, zero 4, bytes "a\n\"\\\001z" }
tdata @tls align 4 = { i32 0 }
sig %s = (int, int) -> int
func @mem %s nullinvalid {
  slot $0 size 32 align 16 hint 64
  slot $1 size 8 align 8 param
  slot $2 size 4 align 4 hint -16 exposed
b0:
  v0:ptr = param 0.0
  v1:i64 = param 1.0
  v2:ptr = ptradd v0, v1
  v3:ptr = ptradd v2, 16
  v4:i64 = psub v3, v0
  v5:i64 = p2i v0
  v6:ptr = i2p v5
  v7:i32 = load.1u v0
  v8:i32 = load.1s v0
  v9:i32 = load.2u v0 align 2
  v10:i32 = load.2s v0 align 2 volatile
  v11:i32 = load.4u v0 align 4 tag 3
  v12:i64 = load.4s v0
  v13:i64 = load.8u v0 align 8
  v14:f32 = load.4 v0
  v15:f64 = load.8 v0 align 8
  v16:ptr = load.8 v0 volatile
  store.1 v0, v7
  store.2 v0, v7 align 2
  store.4 v0, v7 align 4 volatile
  store.8 v0, v1 tag 9
  store.4 v0, v14
  store.8 v0, v15
  store.8 v0, v6
  store.4 $0+4, 7:i32 align 4
  memcpy v0, v2, 24 align 8
  memcpy $0, @tab+8, 16 align 4 align 8
  memcpy v0, v2, 5
  memset v0, 0, 32 align 16
  memset $1, v7, 8
  v17:i32 = aload.4 v0 align 4
  v18:i64 = aload.8 v0 align 8 volatile
  astore.4 v0, v7 align 4
  astore.8 v0, 5:i64
  v19:i32 = axchg.4 v0, v7
  v20:i64 = axadd.8 v0, v1 align 8
  v21:i32 = acas.4 v0, v7, 1
  v22:i64 = acas.8 v0, 0, v1 volatile
  afence
  barrier
  v23:ptr = frameaddr 0
  v24:ptr = retaddr 1
  v25:ptr = tlsaddr @tls, 0
  v26:ptr = tlsaddr @ext, 2
  v27:ptr = ptradd @tab, 4
  v28:ptr = ptradd @ext+24, -8
  v29:ptr = ptradd $2, 0
  v30:ptr = select 1:i32, @tab, $1-4
  ret v1
}
; ---
vir 1
target arm64-darwin
extern @ext
data @tab align 8 = { i32 1, i64 -2, f32 0x1p+0, f64 -0x1.8p+1, ptr @tab+8, ptr 0x10, zero 4, bytes "a\n\"\\\001z" }
tdata @tls align 4 = { i32 0 }
sig %s0 = (int, int) -> int

func @mem %s0 nullinvalid {
  slot $0 size 32 align 16 hint 64
  slot $1 size 8 align 8 param
  slot $2 size 4 align 4 hint -16 exposed
b0:
  v0:ptr = param 0.0
  v1:i64 = param 1.0
  v2:ptr = ptradd v0, v1
  v3:ptr = ptradd v2, 16
  v4:i64 = psub v3, v0
  v5:i64 = p2i v0
  v6:ptr = i2p v5
  v7:i32 = load.1u v0
  v8:i32 = load.1s v0
  v9:i32 = load.2u v0 align 2
  v10:i32 = load.2s v0 volatile align 2
  v11:i32 = load.4u v0 align 4 tag 3
  v12:i64 = load.4s v0
  v13:i64 = load.8u v0 align 8
  v14:f32 = load.4 v0
  v15:f64 = load.8 v0 align 8
  v16:ptr = load.8 v0 volatile
  store.1 v0, v7
  store.2 v0, v7 align 2
  store.4 v0, v7 volatile align 4
  store.8 v0, v1 tag 9
  store.4 v0, v14
  store.8 v0, v15
  store.8 v0, v6
  store.4 $0+4, 7:i32 align 4
  memcpy v0, v2, 24 align 8
  memcpy $0, @tab+8, 16 align 4 align 8
  memcpy v0, v2, 5
  memset v0, 0, 32 align 16
  memset $1, v7, 8
  v17:i32 = aload.4 v0 align 4
  v18:i64 = aload.8 v0 volatile align 8
  astore.4 v0, v7 align 4
  astore.8 v0, 5:i64
  v19:i32 = axchg.4 v0, v7
  v20:i64 = axadd.8 v0, v1 align 8
  v21:i32 = acas.4 v0, v7, 1
  v22:i64 = acas.8 v0, 0, v1 volatile
  afence
  barrier
  v23:ptr = frameaddr 0
  v24:ptr = retaddr 1
  v25:ptr = tlsaddr @tls, 0
  v26:ptr = tlsaddr @ext, 2
  v27:ptr = ptradd @tab, 4
  v28:ptr = ptradd @ext+24, -8
  v29:ptr = ptradd $2, 0
  v30:ptr = select 1:i32, @tab, $1-4
  ret v1
}
