/*
 * The keywords of the lexer's table that an extension gives a meaning in
 * the grammar (doc/PLAN-cxx-parse.md P9).  The parser maps each entry of
 * the table that is one of these, when the extension is on; otherwise the
 * keyword stays standard_keyword::extension, which no production of the
 * standard accepts.
 *
 * ALTERNATE_KEYWORD(spelling, standard_keyword, extension)
 *     another spelling of a keyword of the standard
 * EXTENSION_KEYWORD(name, spelling, extension)
 *     a keyword of the extension's own grammar (extension_keyword::name)
 */
#ifndef ALTERNATE_KEYWORD
#define ALTERNATE_KEYWORD(spelling, keyword, extension)
#endif
#ifndef EXTENSION_KEYWORD
#define EXTENSION_KEYWORD(name, spelling, extension)
#endif

ALTERNATE_KEYWORD("__inline", inline_, gnu_alternate_keywords)
ALTERNATE_KEYWORD("__inline__", inline_, gnu_alternate_keywords)
ALTERNATE_KEYWORD("__const", const_, gnu_alternate_keywords)
ALTERNATE_KEYWORD("__const__", const_, gnu_alternate_keywords)
ALTERNATE_KEYWORD("__signed", signed_, gnu_alternate_keywords)
ALTERNATE_KEYWORD("__signed__", signed_, gnu_alternate_keywords)
ALTERNATE_KEYWORD("__volatile", volatile_, gnu_alternate_keywords)
ALTERNATE_KEYWORD("__volatile__", volatile_, gnu_alternate_keywords)
ALTERNATE_KEYWORD("__asm", asm_, gnu_alternate_keywords)
ALTERNATE_KEYWORD("__asm__", asm_, gnu_alternate_keywords)
ALTERNATE_KEYWORD("__alignof", alignof_, gnu_alternate_keywords)
ALTERNATE_KEYWORD("__alignof__", alignof_, gnu_alternate_keywords)

