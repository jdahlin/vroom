; asm goto: label operands, and a result that a later block uses
vir 1
target x86_64-linux
sig %s = (int) -> int
asm !0 "jmp $l" outs() ins("r") clobber("memory") labels 2
asm !1 "mov $0" outs("=r") ins() clobber() labels 1
func @agoto %s {
b0:
  v0:i64 = param 0.0
  asmgoto !0 outs() ins(0 v0) -> b1 [b2, b3]
b1:
  ret v0
b2:
  ret 1:i64
b3:
  trap
}

func @agoto_out %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = asmgoto !1 outs(0) ins() -> b1 [b2]
b1:
  v2:i64 = add v1, v0
  ret v2
b2:
  ret v1
}
; ---
vir 1
target x86_64-linux
sig %s0 = (int) -> int
asm !0 "jmp $l" outs() ins("r") clobber("memory") labels 2
asm !1 "mov $0" outs("=r") ins() clobber() labels 1

func @agoto %s0 {
b0:
  v0:i64 = param 0.0
  asmgoto !0 outs() ins(0 v0) -> b1 [b2, b3]
b1:
  ret v0
b2:
  ret 1:i64
b3:
  trap
}

func @agoto_out %s0 {
b0:
  v0:i64 = param 0.0
  v1:i64 = asmgoto !1 outs(0) ins() -> b1 [b2]
b1:
  v2:i64 = add v1, v0
  ret v2
b2:
  ret v1
}
