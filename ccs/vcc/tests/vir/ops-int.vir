  v19:i32 = lshr v2, 31 exact
  v20:i64 = ashr v0, 63 exact
  v21:i64 = umulhi v0, v1
  v22:i64 = smulhi v0, v1
  v23:i64 = neg v0 nsw
  v24:i32 = not v2
