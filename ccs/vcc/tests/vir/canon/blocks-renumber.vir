; PASSES: canon
; blocks written in reverse: switch, ibr, asmgoto, labeladdr and br all name the new block numbers
vir 1
target x86_64-linux
sig %s = (int) -> int
asm !0 "jmp $l" outs() ins("r") clobber() labels 1
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i32 = trunc v0
  switch v1, b1 [1: b3, 2..3: b2]
b5:
  ret 5:i64
b4:
  ret 4:i64
b3 addr:
  ret v0
b2:
  v2:ptr = select v1, &b3, &b3
  ibr v2 [b3]
b1:
  asmgoto !0 outs() ins(0 v0) -> b5 [b4]
}
; ---
vir 1
target x86_64-linux
sig %s0 = (int) -> int
asm !0 "jmp $l" outs() ins("r") clobber() labels 1

func @f %s0 {
b0:
  v0:i64 = param 0.0
  v1:i32 = trunc v0
  switch v1, b1 [1: b5, 2..3: b4]
b1:
  asmgoto !0 outs() ins(0 v0) -> b2 [b3]
b2:
  ret 5:i64
b3:
  ret 4:i64
b4:
  v2:ptr = select v1, &b5, &b5
  ibr v2 [b5]
b5 addr:
  ret v0
}
