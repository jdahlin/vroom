; PASSES: canon
; the loop header is written after its body: the blocks are put in reverse postorder
vir 1
target x86_64-linux
sig %s = (int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  br b2(0)
b1:
  v3:i64 = add v1, 1
  br b2(v3)
b2(v1:i64) loop:
  v2:i32 = icmp.slt v1, v0
  brif v2, b1, b3
b3:
  ret v1
}
; ---
vir 1
target x86_64-linux
sig %s0 = (int) -> int

func @f %s0 {
b0:
  v0:i64 = param 0.0
  br b1(0)
b1(v1:i64) loop:
  v2:i32 = icmp.slt v1, v0
  brif v2, b2, b3
b2:
  v3:i64 = add v1, 1
  br b1(v3)
b3:
  ret v1
}
