; DOM: yes
; nested diamonds: b3 is dominated by b0, b6 by b3
vir 1
target x86_64-linux
sig %s = (int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  brif v0, b1, b2
b1:
  br b3
b2:
  br b3
b3:
  brif v0, b4, b5
b4:
  br b6
b5:
  br b6
b6:
  ret v0
}
; ---
vir 1
target x86_64-linux
sig %s0 = (int) -> int

func @f %s0 {
b0:
  v0:i64 = param 0.0
  brif v0, b1, b2
b1:
  br b3
b2:
  br b3
b3:
  brif v0, b4, b5
b4:
  br b6
b5:
  br b6
b6:
  ret v0
}
; dom @f b0 idom b0 pre 0 post 6
; dom @f b1 idom b0 pre 1 post 1
; dom @f b2 idom b0 pre 2 post 2
; dom @f b3 idom b0 pre 3 post 6
; dom @f b4 idom b3 pre 4 post 4
; dom @f b5 idom b3 pre 5 post 5
; dom @f b6 idom b3 pre 6 post 6
