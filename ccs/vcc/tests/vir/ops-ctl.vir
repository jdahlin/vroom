; control flow: parameters, loops, both branch hints, switch (i32 and i64 ranges), ibr, labeladdr, trap
vir 1
target arm64-linux
sig %s = (int) -> int
func @ctl %s {
b0:
  v0:i64 = param 0.0
  v1:i32 = trunc v0
  br b1(v0, 0:i32)
b1(v2:i64, v3:i32) loop:
  v4:i32 = icmp.slt v3, 10
  brif v4, b2, b3 likely
b2 cold:
  v5:i32 = add v3, 1
  br b1(v2, v5)
b3:
  switch v1, b9 [0: b4, 1..5: b5, -1: b6]
b4:
  v6:ptr = select v1, &b7, &b8
  ibr v6 [b7, b8]
b5:
  switch v0, b9 [5..7: b6, 0x100000000: b9, -3: b6]
b6:
  brif v4, b9, b7 unlikely
b7 addr:
  ret v0
b8 addr:
  ret v2
b9:
  trap
}
; ---
vir 1
target arm64-linux
sig %s0 = (int) -> int

func @ctl %s0 {
b0:
  v0:i64 = param 0.0
  v1:i32 = trunc v0
  br b1(v0, 0)
b1(v2:i64, v3:i32) loop:
  v4:i32 = icmp.slt v3, 10
  brif v4, b2, b3 likely
b2 cold:
  v5:i32 = add v3, 1
  br b1(v2, v5)
b3:
  switch v1, b9 [0: b4, 1..5: b5, -1: b6]
b4:
  v6:ptr = select v1, &b7, &b8
  ibr v6 [b7, b8]
b5:
  switch v0, b9 [5..7: b6, 4294967296: b9, -3: b6]
b6:
  brif v4, b9, b7 unlikely
b7 addr:
  ret v0
b8 addr:
  ret v2
b9:
  trap
}
