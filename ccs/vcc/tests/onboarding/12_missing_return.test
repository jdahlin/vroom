id = "B12"
title = "Non-void function misses a return path"
expect = [
  { line = 3, severity = "warning", pattern = "(non-void|nonvoid).*return|control reaches.*end|not all.*return" },
]

=== broken.c ===
int choose(int ready) {
    if (ready) return 1;
}
int main(void) { return choose(0); }
=== fixed.c ===
int choose(int ready) {
    if (ready) return 1;
    return 0;
}
int main(void) { return choose(0); }
=== valid.c ===
int main(void) { /* main may reach its closing brace. */ }
=== stderr ===
broken.c:3:1: warning: non-void function does not return a value in all control paths [-Wreturn-type]
    2 |     if (ready) return 1;
      |         ~~~~~ (1) 'ready' is false
    3 | }
      | ^ (2) 'choose' ends here without a return
      = help: 'choose' returns 'int': end it with a return statement
1 warning generated.
=== narrated ===
broken.c:3:1: warning: non-void function does not return a value in all control paths [-Wreturn-type]
  the source line is: }
