id = "B02"
title = "Missing closing parenthesis"
expect = [
  { line = 2, severity = "error", pattern = "expected.*'\\)'|missing.*(parenthes|\\))" },
]

=== broken.c ===
int main(void) {
    if (1 { return 0; }
    return 1;
}
=== fixed.c ===
int main(void) {
    if (1) { return 0; }
    return 1;
}
=== valid.c ===
int main(void) { if ((1)) { return 0; } return 1; }
=== stderr ===
broken.c:2:11: error: expected ')'
    2 |     if (1 { return 0; }
      |        -  ^
      |        |
      |        to match this '('
broken.c:2:8: note: to match this '('
1 error generated.
