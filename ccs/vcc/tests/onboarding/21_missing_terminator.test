id = "B21"
title = "String use requires space for its terminator"
expect = [
  { line = 3, severity = "warning", pattern = "(terminat|nul|initializer.string.*too long|nonstring)" },
]
known_gap = "Observed x86 vcc baseline is silent for a character array initialized without termination then passed to puts; raw nonstring arrays must remain legal."

=== broken.c ===
int puts(const char *);
int main(void) {
    char text[3] = "cat";
    puts(text);
    return 0;
}
=== fixed.c ===
int puts(const char *);
int main(void) {
    char text[] = "cat";
    puts(text);
    return 0;
}
=== valid.c ===
int main(void) { char bytes[3]={'c','a','t'}; return bytes[2] != 't'; }
