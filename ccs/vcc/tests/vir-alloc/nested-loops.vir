; nested loops: an outer counter, an inner counter, a sum carried through both,
; and a value defined before the loops used only after them (live through)
; REGS: 5,2,1,0
; SWEEP: yes
vir 1
target x86_64-linux
sig %s = (int, int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = param 1.0
  v2:i64 = mul v0, v1
  br b1(0:i64, 0:i64)
b1(v3:i64, v4:i64) loop:
  br b2(0:i64, v4)
b2(v5:i64, v6:i64) loop:
  v7:i64 = mul v3, v5
  v8:i64 = add v6, v7
  v9:i64 = add v5, 1
  v10:i32 = icmp.slt v9, v1
  brif v10, b5, b3
b5:
  br b2(v9, v8)
b3:
  v11:i64 = add v3, 1
  v12:i32 = icmp.slt v11, v0
  brif v12, b6, b4
b6:
  br b1(v11, v8)
b4:
  v13:i64 = add v8, v2
  ret v13
}
; ---
; alloc @f regs 5,2,1,0
func @f %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0 [ss1]
  v1:i64 = param 1.0                    ; -> r1
  v2:i64 = mul v0, v1                   ; r0, r1 -> r2 [ss0]
  br b1(0, 0)                           ; -, -
b1(v3:i64, v4:i64) loop:                ; loop to b5 depth 1; v3 r2, v4 r3
  br b2(0, v4)                          ; -, r3
b2(v5:i64, v6:i64) loop:                ; loop to b3 depth 2; v5 r0, v6 r3
  v7:i64 = mul v3, v5                   ; r2, r0 -> r4
  v8:i64 = add v6, v7                   ; r3, r4 -> r3
  v9:i64 = add v5, 1                    ; r0, - -> r0
  v10:i32 = icmp.slt v9, v1             ; r0, r1 -> r4
  brif v10, b3, b4                      ; r4
b3:
  br b2(v9, v8)                         ; r0, r3
b4:
  v11:i64 = add v3, 1                   ; r2, - -> r2
  ; reload r0 <- v0 (ss1)
  v12:i32 = icmp.slt v11, v0            ; r2, r0 -> r4
  brif v12, b5, b6                      ; r4
b5:
  br b1(v11, v8)                        ; r2, r3
b6:
  ; reload r0 <- v2 (ss0)
  v13:i64 = add v8, v2                  ; r3, r0 -> r0
  ret v13                               ; r0
}
; edge b0.0 -> b1: r2 <- 0; r3 <- 0
; edge b1.0 -> b2: r0 <- 0
; spill slots: ss0(8): v2 ss1(8): v0
; callee-saved: r4 (b2)
; spills 2 reloads 2 remats 0 moves 0 swaps 0; edges 2: moves 0 reloads 0 remats 3 stores 0 xchg 0; slots 2 callee 1
; sweep @f: 36 configurations, 0 failed
