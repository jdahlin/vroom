; straight-line pressure: six values live at once with four integer registers
; REGS: 4,2,0,0
; SWEEP: yes
vir 1
target x86_64-linux
sig %s = (int, int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = param 1.0
  v2:i64 = add v0, v1
  v3:i64 = mul v0, v1
  v4:i64 = sub v0, v1
  v5:i64 = xor v2, v3
  v6:i64 = add v4, 7
  v7:i64 = and v6, v2
  v8:i64 = add v7, v5
  v9:i64 = add v8, v3
  v10:i64 = add v9, v4
  v11:i64 = add v10, v0
  ret v11
}
; ---
; alloc @f regs 4,2,0,0
func @f %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0 [ss0 later]
  v1:i64 = param 1.0                    ; -> r1
  v2:i64 = add v0, v1                   ; r0, r1 -> r2
  v3:i64 = mul v0, v1                   ; r0, r1 -> r3
  v4:i64 = sub v0, v1                   ; r0, r1 -> r1 [ss1 later]
  ; store ss0 <- r0 (v0)
  v5:i64 = xor v2, v3                   ; r2, r3 -> r0
  ; store ss1 <- r1 (v4)
  v6:i64 = add v4, 7                    ; r1, - -> r1
  v7:i64 = and v6, v2                   ; r1, r2 -> r1
  v8:i64 = add v7, v5                   ; r1, r0 -> r0
  v9:i64 = add v8, v3                   ; r0, r3 -> r0
  ; reload r1 <- v4 (ss1)
  v10:i64 = add v9, v4                  ; r0, r1 -> r0
  ; reload r1 <- v0 (ss0)
  v11:i64 = add v10, v0                 ; r0, r1 -> r0
  ret v11                               ; r0
}
