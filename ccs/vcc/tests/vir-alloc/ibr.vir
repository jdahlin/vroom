; computed goto: `ibr` to address-taken blocks, which start with every
; live-in value in its slot
; REGS: 4,2,0,0
; SWEEP: yes
vir 1
target x86_64-linux
sig %s = (int, int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = param 1.0
  v2:i64 = mul v0, v1
  v3:i32 = trunc v0
  v4:ptr = select v3, &b1, &b2
  ibr v4 [b1, b2]
b1 addr:
  v5:i64 = add v2, v1
  v6:i32 = icmp.slt v5, 100
  v7:ptr = select v6, &b2, &b1
  ibr v7 [b1, b2]
b2 addr:
  v8:i64 = add v2, v0
  ret v8
}
; ---
; alloc @f regs 4,2,0,0
func @f %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0 [ss0]
  v1:i64 = param 1.0                    ; -> r1 [ss1]
  v2:i64 = mul v0, v1                   ; r0, r1 -> r2 [ss2]
  v3:i32 = trunc v0                     ; r0 -> r3
  ; remat r0 <- &b1
  ; remat r1 <- &b2
  v4:ptr = select v3, &b1, &b2          ; r3, r0, r1 -> r3
  ibr v4 [b1, b2]                       ; r3
b1 addr:                                ; loop to b1 depth 1
  ; reload r0 <- v2 (ss2)
  ; reload r1 <- v1 (ss1)
  v5:i64 = add v2, v1                   ; r0, r1 -> r2
  v6:i32 = icmp.slt v5, 100             ; r2, - -> r2
  ; remat r3 <- &b2
  ; remat r0 <- &b1
  v7:ptr = select v6, &b2, &b1          ; r2, r3, r0 -> r0
  ibr v7 [b1, b2]                       ; r0
b2 addr:
  ; reload r0 <- v2 (ss2)
  ; reload r1 <- v0 (ss0)
  v8:i64 = add v2, v0                   ; r0, r1 -> r0
  ret v8                                ; r0
}
; spill slots: ss0(8): v0 ss1(8): v1 ss2(8): v2
; spills 3 reloads 4 remats 4 moves 0 swaps 0 stores 0; edges 0: moves 0 reloads 0 remats 0 stores 0 xchg 0; slots 3 callee 0
; sweep @f: 24 configurations, 0 failed
