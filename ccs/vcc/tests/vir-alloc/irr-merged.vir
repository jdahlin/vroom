; overlapping loops b1..b3 and b2..b4 merge into one loop headed by b1; b2 is
; the target of a back edge without being the head, and v2 is live there (used
; in b2) but not at b1: it is live around the loop only through b2's back
; edge, so the value must survive b1's pressure (15.5: lend at every back-edge
; target, not only at the head)
; REGS: 4,2,0,0
; SWEEP: yes
vir 1
target x86_64-linux
sig %s = (int, int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = param 1.0
  v2:i64 = mul v0, v1
  v3:i32 = icmp.slt v0, v1
  brif v3, b1, b2
b1:
  v4:i64 = add v0, v1
  v5:i64 = mul v4, v0
  v6:i64 = sub v5, v1
  v7:i64 = xor v6, v4
  v8:i64 = or v7, v5
  br b3
b2:
  v9:i64 = add v2, v0
  br b4
b3:
  v10:i32 = icmp.slt v0, 7
  brif v10, b1, b4
b4:
  v11:i32 = icmp.slt v1, 9
  brif v11, b2, b5
b5:
  ret v1
}
; ---
; alloc @f regs 4,2,0,0
func @f %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0 [ss0]
  v1:i64 = param 1.0                    ; -> r1 [ss1]
  v2:i64 = mul v0, v1                   ; r0, r1 -> r2
  v3:i32 = icmp.slt v0, v1              ; r0, r1 -> r3
  brif v3, b1, b2                       ; r3
b1:                                     ; loop to b4 depth 1
  v4:i64 = add v0, v1                   ; r0, r1 -> r3
  v5:i64 = mul v4, v0                   ; r3, r0 -> r0
  v6:i64 = sub v5, v1                   ; r0, r1 -> r1
  v7:i64 = xor v6, v4                   ; r1, r3 -> r1
  v8:i64 = or v7, v5                    ; r1, r0 -> r3
  br b3                                 ;
b2:
  v9:i64 = add v2, v0                   ; r2, r0 -> r3
  br b4                                 ;
b3:
  ; reload r0 <- v0 (ss0)
  v10:i32 = icmp.slt v0, 7              ; r0, - -> r1
  brif v10, b1, b4                      ; r1
b4:
  v11:i32 = icmp.slt v1, 9              ; r1, - -> r3
  brif v11, b2, b5                      ; r3
b5:
  ; move r0 <- r1 (v1)
  ret v1                                ; r0
}
; edge b3.0 -> b1: r1 <- ss1 (v1)
; edge b3.1 -> b4: r1 <- ss1 (v1)
; spill slots: ss0(8): v0 ss1(8): v1
; spills 2 reloads 1 remats 0 moves 1 swaps 0; edges 2: moves 0 reloads 2 remats 0 stores 0 xchg 0; slots 2 callee 0
; sweep @f: 24 configurations, 0 failed
