; an address-taken block inside a loop: it starts with every value in its
; slot, so v2, live around the loop (used only at the head) but not used in or
; after b3, still needs a slot or the back edge b3 -> b1 cannot restore it
; REGS: 8,2,0,0
; SWEEP: yes
vir 1
target x86_64-linux
sig %s = (int, int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = param 1.0
  v2:i64 = mul v0, v1
  br b1
b1:
  v3:i64 = add v2, v0
  v4:i32 = icmp.slt v3, v1
  brif v4, b2, b4
b2:
  v5:i32 = trunc v1
  v6:ptr = select v5, &b3, &b3
  ibr v6 [b3]
b3 addr:
  v7:i64 = add v0, v1
  v8:i64 = mul v7, v0
  v9:i64 = sub v8, v1
  br b1
b4:
  ret v1
}
; ---
; alloc @f regs 8,2,0,0
func @f %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0 [ss0]
  v1:i64 = param 1.0                    ; -> r1 [ss1]
  v2:i64 = mul v0, v1                   ; r0, r1 -> r2 [ss2]
  br b1                                 ;
b1:                                     ; loop to b3 depth 1
  v3:i64 = add v2, v0                   ; r2, r0 -> r3
  v4:i32 = icmp.slt v3, v1              ; r3, r1 -> r3
  brif v4, b2, b4                       ; r3
b2:
  v5:i32 = trunc v1                     ; r1 -> r3
  ; remat r4 <- &b3
  v6:ptr = select v5, &b3, &b3          ; r3, r4, r4 -> r3
  ibr v6 [b3]                           ; r3
b3 addr:
  ; reload r0 <- v0 (ss0)
  ; reload r1 <- v1 (ss1)
  v7:i64 = add v0, v1                   ; r0, r1 -> r2
  v8:i64 = mul v7, v0                   ; r2, r0 -> r2
  v9:i64 = sub v8, v1                   ; r2, r1 -> r3
  br b1                                 ;
b4:
  ; move r0 <- r1 (v1)
  ret v1                                ; r0
}
; edge b3.0 -> b1: r2 <- ss2 (v2)
; spill slots: ss0(8): v0 ss1(8): v1 ss2(8): v2
; spills 3 reloads 2 remats 1 moves 1 swaps 0; edges 1: moves 0 reloads 1 remats 0 stores 0 xchg 0; slots 3 callee 0
; sweep @f: 72 configurations, 0 failed
