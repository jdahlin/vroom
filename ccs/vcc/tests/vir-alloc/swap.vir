; block arguments that swap and rotate: the edge's parallel move has cycles
; REGS: 6,2,0,0
; SWEEP: yes
vir 1
target x86_64-linux
sig %s = (int, int, int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = param 1.0
  v2:i64 = param 2.0
  br b1(v0, v1, v2, 0:i64)
b1(v3:i64, v4:i64, v5:i64, v6:i64) loop:
  v7:i64 = add v6, 1
  v8:i32 = icmp.slt v7, 10
  brif v8, b2, b3
b2:
  br b1(v4, v5, v3, v7)
b3:
  v9:i64 = sub v3, v4
  v10:i64 = sub v9, v5
  ret v10
}
; ---
; alloc @f regs 6,2,0,0
func @f %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0
  v1:i64 = param 1.0                    ; -> r1
  v2:i64 = param 2.0                    ; -> r2
  br b1(v0, v1, v2, 0)                  ; r0, r1, r2, -
b1(v3:i64, v4:i64, v5:i64, v6:i64) loop: ; loop to b2 depth 1; v3 r0, v4 r1, v5 r2, v6 r3
  v7:i64 = add v6, 1                    ; r3, - -> r3
  v8:i32 = icmp.slt v7, 10              ; r3, - -> r4
  brif v8, b2, b3                       ; r4
b2:
  br b1(v4, v5, v3, v7)                 ; r1, r2, r0, r3
b3:
  v9:i64 = sub v3, v4                   ; r0, r1 -> r0
  v10:i64 = sub v9, v5                  ; r0, r2 -> r0
  ret v10                               ; r0
}
; edge b0.0 -> b1: r3 <- 0
; edge b2.0 -> b1: r4 <- r0 (v3); r0 <- r1 (v4); r1 <- r2 (v5); r2 <- r4 (v3)
; spills 0 reloads 0 remats 0 moves 0 swaps 0; edges 2: moves 4 reloads 0 remats 1 stores 0 xchg 0; slots 0 callee 0
; sweep @f: 48 configurations, 0 failed
