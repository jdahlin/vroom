; alloc @dead regs 4,3,1,1 x86
func @dead %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0
  switch v0, b3 [0: b1, 1..3: b2]       ; r0
b1:
  ; remat r0 <- 17
  ret 17:i64                            ; r0
b2:
  ; remat r0 <- 31
  ret 31:i64                            ; r0
b3:
  ; remat r0 <- 43
  ret 43:i64                            ; r0
