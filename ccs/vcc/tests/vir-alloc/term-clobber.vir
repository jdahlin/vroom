; A dispatch may destroy registers even though it produces no value.
; Synthetic x86 switch: r0 late clobber, r1 early clobber. The selector
; and another parameter remain live on its edges, including loop backedges.
; REGS: 4,3,1,1
; X86: yes
; SWEEP: yes
vir 1
target x86_64-linux
sig %s = (int, int) -> int
func @keep %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = param 1.0
  switch v1, b3 [0: b1, 1..3: b2]
b1:
  v2:i64 = add v0, v1
  ret v2
b2:
  v3:i64 = sub v0, v1
  ret v3
b3:
  v4:i64 = xor v0, v1
  ret v4
}
func @loop %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = param 1.0
  br b1(v0, v1)
b1(v2:i64, v3:i64):
  switch v3, b4 [0: b4, 1..3: b2, 4: b3]
b2:
  v4:i64 = add v2, v3
  v5:i64 = sub v3, 1:i64
  br b1(v4, v5)
b3:
  v6:i64 = xor v2, v3
  v7:i64 = sub v3, 2:i64
  br b1(v6, v7)
b4:
  ret v2
}
func @dead %s {
b0:
  v0:i64 = param 0.0
  switch v0, b3 [0: b1, 1..3: b2]
b1:
  ret 17:i64
b2:
  ret 31:i64
b3:
  ret 43:i64
}
; ---
; alloc @keep regs 4,3,1,1 x86
func @keep %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0
  v1:i64 = param 1.0                    ; -> r1
  ; move r2 <- r1 (v1)
  ; move r3 <- r0 (v0)
  switch v1, b3 [0: b1, 1..3: b2]       ; r2
b1:
  v2:i64 = add v0, v1                   ; r3, r2 -> r3
  ; move r0 <- r3 (v2)
  ret v2                                ; r0
b2:
  v3:i64 = sub v0, v1                   ; r3, r2 -> r3
  ; move r0 <- r3 (v3)
  ret v3                                ; r0
b3:
  v4:i64 = xor v0, v1                   ; r3, r2 -> r3
  ; move r0 <- r3 (v4)
  ret v4                                ; r0
}
; callee-saved: r3 (b0)
; spills 0 reloads 0 remats 0 moves 5 swaps 0 stores 0; edges 0: moves 0 reloads 0 remats 0 stores 0 xchg 0; slots 0 callee 1
; sweep @keep: 48 configurations, 0 failed
; alloc @loop regs 4,3,1,1 x86
func @loop %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0
  v1:i64 = param 1.0                    ; -> r1
  br b1(v0, v1)                         ; r0, r1
b1(v2:i64, v3:i64):                     ; loop to b3 depth 1; v2 r0, v3 r1
  ; move r2 <- r1 (v3)
  ; move r3 <- r0 (v2)
  switch v3, b4 [0: b4, 1..3: b2, 4: b3] ; r2
b2:
  v4:i64 = add v2, v3                   ; r3, r2 -> r3
  v5:i64 = sub v3, 1                    ; r2, - -> r2
  br b1(v4, v5)                         ; r3, r2
b3:
  v6:i64 = xor v2, v3                   ; r3, r2 -> r3
  v7:i64 = sub v3, 2                    ; r2, - -> r2
  br b1(v6, v7)                         ; r3, r2
b4:
  ; move r0 <- r3 (v2)
  ret v2                                ; r0
}
; edge b2.0 -> b1: r0 <- r3 (v4); r1 <- r2 (v5)
; edge b3.0 -> b1: r0 <- r3 (v6); r1 <- r2 (v7)
; callee-saved: r3 (b1)
; spills 0 reloads 0 remats 0 moves 3 swaps 0 stores 0; edges 2: moves 4 reloads 0 remats 0 stores 0 xchg 0; slots 0 callee 1
