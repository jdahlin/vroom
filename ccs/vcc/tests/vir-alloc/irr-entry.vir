; the inner loop b3..b4 is entered at its head b3 (from b2) and in its middle
; at b4 from the outer loop's head b1 (irreducible); v2 is used only in b3, so
; it is in neither b4's nor b1's live-in set, yet it is live on
; b5 -> b1 -> b4 -> b3: an edge into the middle of a loop carries the values
; live around it (15.5), which makes v2 live around the outer loop, so b5's
; pressure must not lose it
; REGS: 8,2,0,0
; SWEEP: yes
vir 1
target x86_64-linux
sig %s = (int, int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = param 1.0
  v2:i64 = mul v0, v1
  v3:i32 = icmp.slt v0, v1
  brif v3, b1, b2
b1:
  v4:i32 = icmp.slt v1, 3
  br b4
b2:
  br b3
b3:
  v5:i64 = add v2, v0
  br b4
b4:
  v6:i32 = icmp.slt v0, 7
  brif v6, b3, b5
b5:
  v7:i64 = add v0, v1
  v8:i64 = mul v7, v0
  v9:i64 = sub v8, v1
  v10:i64 = xor v9, v7
  v11:i64 = or v10, v8
  v12:i32 = icmp.slt v11, 5
  brif v12, b1, b6
b6:
  ret v1
}
