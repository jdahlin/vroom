; alloc @f regs 8,2,0,0
func @f %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0
  v1:i64 = param 1.0                    ; -> r1
  v2:i64 = mul v0, v1                   ; r0, r1 -> r2
  v3:i32 = icmp.slt v0, v1              ; r0, r1 -> r3
  brif v3, b1, b2                       ; r3
b1:                                     ; loop to b5 depth 1
  v4:i32 = icmp.slt v1, 3               ; r1, - -> r3
  br b4                                 ;
b2:
  br b3                                 ;
b3:                                     ; loop to b4 depth 2
  v5:i64 = add v2, v0                   ; r2, r0 -> r3
  br b4                                 ;
b4:
  v6:i32 = icmp.slt v0, 7               ; r0, - -> r3
  brif v6, b3, b5                       ; r3
b5:
  v7:i64 = add v0, v1                   ; r0, r1 -> r3
  v8:i64 = mul v7, v0                   ; r3, r0 -> r4
  v9:i64 = sub v8, v1                   ; r4, r1 -> r5
  v10:i64 = xor v9, v7                  ; r5, r3 -> r3
  v11:i64 = or v10, v8                  ; r3, r4 -> r3
  v12:i32 = icmp.slt v11, 5             ; r3, - -> r3
  brif v12, b1, b6                      ; r3
b6:
  ; move r0 <- r1 (v1)
  ret v1                                ; r0
}
