; x86: the shift count must be in r2, which is callee-saved here; only an edit
; (`move r2 <- r0`) writes it, and that still puts r2 in the callee-saved set
; REGS: 4,3,2,1
; X86: yes
; SWEEP: yes
vir 1
target x86_64-linux
sig %s = (int) -> int
func @f %s {
  slot $0 size 8 align 8
b0:
  v0:i64 = param 0.0
  v1:f64 = s2f v0
  v2:i32 = icmp.ne v0, v0
  v3:f64 = fadd v1, v1
  store.8 $0, v0
  v4:i64 = lshr v0, v0
  v5:f64 = fadd v3, 0x1.1p+1:f64
  ret v4
}
; ---
; alloc @f regs 4,3,2,1 x86
func @f %s0 {
  slot $0 size 8 align 8
b0:
  v0:i64 = param 0.0                    ; -> r0
  v1:f64 = s2f v0                       ; r0 -> f0
  v2:i32 = icmp.ne v0, v0               ; r0, r0 -> r1
  v3:f64 = fadd v1, v1                  ; f0, f0 -> f0
  ; remat r1 <- $0
  store.8 $0, v0                        ; r1, r0
  ; move r2 <- r0 (v0)
  v4:i64 = lshr v0, v0                  ; r0, r2 -> r0
  ; remat f1 <- bits:0x4001000000000000
  v5:f64 = fadd v3, 0x1.1p+1            ; f0, f1 -> f2
  ret v4                                ; r0
}
; callee-saved: r2 (b0) f2 (b0)
; spills 0 reloads 0 remats 2 moves 1 swaps 0 stores 0; edges 0: moves 0 reloads 0 remats 0 stores 0 xchg 0; slots 0 callee 2
; sweep @f: 48 configurations, 0 failed
