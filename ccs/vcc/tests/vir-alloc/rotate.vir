; a rotation of three block arguments with every register taken: no free
; register breaks the cycle, so the edge exchanges (VE_XCHG): two exchanges,
; and the third move is then already done
; REGS: 3,2,0,0
; SWEEP: yes
vir 1
target x86_64-linux
sig %s = (int, int, int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = param 1.0
  v2:i64 = param 2.0
  br b1(v0, v1, v2)
b1(v3:i64, v4:i64, v5:i64):
  brif v3, b2, b3
b2:
  br b1(v4, v5, v3)
b3:
  v6:i64 = add v3, v4
  v7:i64 = add v6, v5
  ret v7
}
; ---
; alloc @f regs 3,2,0,0
func @f %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0
  v1:i64 = param 1.0                    ; -> r1
  v2:i64 = param 2.0                    ; -> r2
  br b1(v0, v1, v2)                     ; r0, r1, r2
b1(v3:i64, v4:i64, v5:i64):             ; loop to b2 depth 1; v3 r0, v4 r1, v5 r2
  brif v3, b2, b3                       ; r0
b2:
  br b1(v4, v5, v3)                     ; r1, r2, r0
b3:
  v6:i64 = add v3, v4                   ; r0, r1 -> r0
  v7:i64 = add v6, v5                   ; r0, r2 -> r0
  ret v7                                ; r0
}
; edge b2.0 -> b1: r0 <-> r1 (v4); r1 <-> r2 (v5)
; spills 0 reloads 0 remats 0 moves 0 swaps 0 stores 0; edges 1: moves 0 reloads 0 remats 0 stores 0 xchg 2; slots 0 callee 0
; sweep @f: 12 configurations, 0 failed
