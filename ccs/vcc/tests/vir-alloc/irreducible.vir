; irreducible control flow: a cycle b1 <-> b2 entered at both blocks, with a
; value defined before it and used on both, and one defined in b1 that is live
; around the cycle into b2 only through b1
; REGS: 3,2,0,0
; SWEEP: yes
vir 1
target x86_64-linux
sig %s = (int, int) -> int
func @f %s {
b0:
  v0:i64 = param 0.0
  v1:i64 = param 1.0
  v2:i64 = mul v0, v1
  v3:i32 = icmp.slt v0, v1
  brif v3, b1, b2
b1:
  v4:i64 = add v2, v0
  v5:i32 = icmp.slt v4, v1
  brif v5, b2, b3
b2:
  v6:i64 = sub v2, v1
  v7:i32 = icmp.eq v6, 0
  brif v7, b3, b1
b3:
  v8:i64 = add v2, v1
  ret v8
}
; ---
; alloc @f regs 3,2,0,0
func @f %s0 {
b0:
  v0:i64 = param 0.0                    ; -> r0 [ss1]
  v1:i64 = param 1.0                    ; -> r1 [ss0]
  v2:i64 = mul v0, v1                   ; r0, r1 -> r2
  v3:i32 = icmp.slt v0, v1              ; r0, r1 -> r1
  brif v3, b1, b2                       ; r1
b1:                                     ; loop to b2 depth 1
  v4:i64 = add v2, v0                   ; r2, r0 -> r1
  ; reload r0 <- v1 (ss0)
  v5:i32 = icmp.slt v4, v1              ; r1, r0 -> r1
  brif v5, b2, b3                       ; r1
b2:
  v6:i64 = sub v2, v1                   ; r2, r0 -> r1
  v7:i32 = icmp.eq v6, 0                ; r1, - -> r1
  brif v7, b3, b1                       ; r1
b3:
  v8:i64 = add v2, v1                   ; r2, r0 -> r0
  ret v8                                ; r0
}
; edge b0.1 -> b2: r0 <- ss0 (v1)
; edge b2.1 -> b1: r0 <- ss1 (v0)
; spill slots: ss0(8): v1 ss1(8): v0
; spills 2 reloads 1 remats 0 moves 0 swaps 0; edges 2: moves 0 reloads 2 remats 0 stores 0 xchg 0; slots 2 callee 0
; sweep @f: 12 configurations, 0 failed
