# Linux 7.4-rc2 arm64: changes from allmodconfig for the vcc measurement.
# CONFIG_CC_HAS_KASAN_MEMINTRINSIC_PREFIX is not set
# CONFIG_CC_HAS_UBSAN_ARRAY_BOUNDS is not set
# CONFIG_CFI is not set
# CONFIG_CFI_ICALL_NORMALIZE_INTEGERS is not set
# CONFIG_CFI_PERMISSIVE is not set
# CONFIG_COMPAT_VDSO is not set
CONFIG_DYNAMIC_FTRACE_WITH_CALL_OPS=y
CONFIG_FUNCTION_ALIGNMENT_8B=y
CONFIG_HAVE_DYNAMIC_FTRACE_WITH_CALL_OPS=y
# CONFIG_HAVE_STATIC_CALL is not set
# CONFIG_KASAN is not set
# CONFIG_KASAN_EXTRA_INFO is not set
# CONFIG_KASAN_GENERIC is not set
# CONFIG_KASAN_INLINE is not set
# CONFIG_KASAN_KUNIT_TEST is not set
# CONFIG_KASAN_SHADOW_OFFSET is not set
# CONFIG_KASAN_VMALLOC is not set
# CONFIG_KCOV is not set
# CONFIG_KCOV_ENABLE_COMPARISONS is not set
# CONFIG_KCOV_INSTRUMENT_ALL is not set
# CONFIG_KCOV_IRQ_AREA_SIZE is not set
# CONFIG_KCOV_SELFTEST is not set
CONFIG_KMALLOC_PARTITION_RANDOM=y
# CONFIG_KMALLOC_PARTITION_TYPED is not set
# CONFIG_RANDSTRUCT is not set
# CONFIG_RANDSTRUCT_FULL is not set
CONFIG_RANDSTRUCT_NONE=y
# CONFIG_SLUB_RCU_DEBUG is not set
# CONFIG_STATIC_CALL_SELFTEST is not set
# CONFIG_TEST_UBSAN is not set
# CONFIG_THUMB2_COMPAT_VDSO is not set
# CONFIG_UBSAN is not set
# CONFIG_UBSAN_ARRAY_BOUNDS is not set
# CONFIG_UBSAN_BOOL is not set
# CONFIG_UBSAN_BOUNDS is not set
# CONFIG_UBSAN_ENUM is not set
# CONFIG_UBSAN_KVM_EL2 is not set
# CONFIG_UBSAN_SHIFT is not set
# CONFIG_UBSAN_UNREACHABLE is not set
